{
  "manifest_version": 3,
  "name": "算法竞赛++ 浏览器桥接",
  "version": "0.1.0",
  "description": "把 AtCoder / 洛谷 / 牛客 / Codeforces 比赛页面数据（登录态、页面上下文）转发给本机 算法竞赛++ Engine，不接管账号密码。",
  "minimum_chrome_version": "121",
  "browser_specific_settings": {
    "gecko": {
      "id": "ojhc-bridge@algorithmcontestpp.local",
      "strict_min_version": "140.0",
      "data_collection_permissions": {
        "required": ["websiteContent"]
      }
    }
  },
  "permissions": [
    "storage"
  ],
  "host_permissions": [
    "http://127.0.0.1/*",
    "https://atcoder.jp/*",
    "https://www.luogu.com.cn/*",
    "https://ac.nowcoder.com/*",
    "https://codeforces.com/*"
  ],
  "background": {
    "service_worker": "background.js",
    "scripts": ["background.js"]
  },
  "content_scripts": [
    {
      "matches": [
        "https://atcoder.jp/contests/*",
        "https://www.luogu.com.cn/contest/*",
        "https://ac.nowcoder.com/acm/contest/*",
        "https://codeforces.com/contest/*",
        "https://codeforces.com/gym/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_title": "算法竞赛++ 浏览器桥接",
    "default_popup": "popup.html"
  }
}
