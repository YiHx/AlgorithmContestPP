{
  "id": "ojhc_link",
  "name": "算法竞赛++",
  "version": "0.1.1",
  "sdk": "1",
  "author": "xuanh08",
  "description": "将在线评测平台的判题结果接入 DGHub。发布包内置引擎。",
  "entry": "main.py",
  "capabilities": {
    "startup_check": true
  },
  "config_schema": [
    {
      "section": "Engine 启动器（可选）",
      "fields": [
        {
          "key": "auto_start_engine",
          "type": "bool",
          "label": "插件启动时自动打开引擎终端（需填 URL 和 handle）",
          "default": false,
          "description": "在独立终端启动引擎，终端会显示判题和连接状态"
        },
        {
          "key": "engine_url",
          "type": "text",
          "label": "比赛 URL（例如 https://codeforces.com/contest/1234）",
          "default": ""
        },
        {
          "key": "engine_handle",
          "type": "text",
          "label": "你的 OJ 用户名",
          "default": ""
        },
        {
          "key": "engine_device",
          "type": "bool",
          "label": "带设备输出（关闭=只记录不出电）",
          "default": true
        },
        {
          "key": "engine_virtual",
          "type": "bool",
          "label": "虚拟参赛：从现在开始计时",
          "default": false
        },
        {
          "key": "engine_dir",
          "type": "text",
          "label": "引擎目录（源码运行时使用，发布包自动使用内置引擎）",
          "default": ""
        },
        {
          "key": "engine_python",
          "type": "text",
          "label": "Python 可执行文件（仅源码运行时使用）",
          "default": "python"
        }
      ]
    },
    {
      "section": "模式",
      "fields": [
        {
          "key": "use_pressure_mode",
          "type": "bool",
          "label": "使用压力算法模式（关闭 = 简单模式：单次失败也电 + 没 AC 递增）",
          "default": false,
          "description": "开：按排名/进度/卡题程度触发；关：只看单次失败和没 AC 时长"
        },
        {
          "key": "no_ac_enabled",
          "type": "bool",
          "label": "长时间未 AC 时也反馈",
          "default": true
        },
        {
          "key": "no_ac_minutes",
          "type": "number",
          "label": "简单模式：多久没 AC 电一次（分钟）",
          "default": 20,
          "min": 5,
          "max": 120
        },
        {
          "key": "no_ac_escalation",
          "type": "percent",
          "label": "每次「没 AC」电击比上次加强多少",
          "default": 5,
          "min": 0,
          "max": 20,
          "description": "逐次递增，封顶 90%（App 上限的 90%）"
        }
      ]
    },
    {
      "section": "连接",
      "fields": [
        {
          "key": "link_file",
          "type": "text",
          "label": "Engine 链路文件（留空自动找 ~/.ojhc/device_link.json）",
          "default": ""
        }
      ]
    },
    {
      "section": "强度（App 上限的百分比）",
      "fields": [
        {
          "key": "base_intensity",
          "type": "percent",
          "label": "基础强度（s=2 档）",
          "default": 74,
          "min": 40,
          "max": 90,
          "description": "输出去电强度 = 基础强度 + (档位-2)×每档递增，均为 App 上限的百分比"
        },
        {
          "key": "intensity_step",
          "type": "percent",
          "label": "每档递增",
          "default": 4,
          "min": 0,
          "max": 10
        },
        {
          "key": "max_s",
          "type": "number",
          "label": "最高档位 s（2-5）",
          "default": 4,
          "min": 2,
          "max": 5
        },
        {
          "key": "preset",
          "type": "preset",
          "label": "波形预设",
          "default": "呼吸"
        }
      ]
    },
    {
      "section": "频率与安全",
      "fields": [
        {
          "key": "cooldown_s",
          "type": "number",
          "label": "两次电击最小间隔（秒）",
          "default": 10,
          "min": 10,
          "max": 300
        },
        {
          "key": "hourly_cap",
          "type": "number",
          "label": "每小时最多次数",
          "default": 30,
          "min": 5,
          "max": 60
        },
        {
          "key": "allow_level_up",
          "type": "bool",
          "label": "等级上升时也电一下",
          "default": false
        },
        {
          "key": "max_intensity_pct",
          "type": "percent",
          "label": "本插件硬上限（0~100%，100%=App 上限）",
          "default": 90,
          "min": 0,
          "max": 100,
          "description": "没 AC 的递增电击也停在这个值；代码兜底 100%，永远不会超过 App 上限"
        },
        {
          "key": "show_status",
          "type": "bool",
          "label": "在 DGHub 显示运行状态",
          "default": true
        }
      ]
    }
  ]
}
