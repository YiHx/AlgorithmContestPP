{
  "id": "ojhc_link",
  "name": "OJHC 硬核模式",
  "version": "0.1.0",
  "sdk": "1",
  "author": "xuanh08",
  "description": "OJ Hardcore Engine 的设备执行端：只接受 Engine 的租约化输出指令，租约过期/断开立即归零。",
  "entry": "main.py",
  "capabilities": {
    "startup_check": true
  },
  "config_schema": [
    {
      "section": "连接",
      "fields": [
        {
          "key": "link_file",
          "type": "text",
          "label": "Engine 链路文件（留空自动找 ~/.ojhc/device_link.json）",
          "default": ""
        }
      ]
    },
    {
      "section": "强度（App 上限的百分比）",
      "fields": [
        {
          "key": "base_intensity",
          "type": "percent",
          "label": "基础强度（s=2 档）",
          "default": 74,
          "min": 40,
          "max": 90,
          "description": "输出去电强度 = 基础强度 + (档位-2)×每档递增，均为 App 上限的百分比"
        },
        {
          "key": "intensity_step",
          "type": "percent",
          "label": "每档递增",
          "default": 4,
          "min": 0,
          "max": 10
        },
        {
          "key": "max_s",
          "type": "number",
          "label": "最高档位 s（2-5）",
          "default": 4,
          "min": 2,
          "max": 5
        },
        {
          "key": "preset",
          "type": "preset",
          "label": "波形预设",
          "default": "呼吸"
        }
      ]
    },
    {
      "section": "频率与安全",
      "fields": [
        {
          "key": "cooldown_s",
          "type": "number",
          "label": "两次电击最小间隔（秒）",
          "default": 90,
          "min": 30,
          "max": 300
        },
        {
          "key": "hourly_cap",
          "type": "number",
          "label": "每小时最多次数",
          "default": 30,
          "min": 5,
          "max": 60
        },
        {
          "key": "allow_level_up",
          "type": "bool",
          "label": "等级上升时也电一下",
          "default": false
        },
        {
          "key": "max_intensity_pct",
          "type": "percent",
          "label": "本插件硬上限（代码上限 90%）",
          "default": 90,
          "min": 0,
          "max": 90,
          "description": "即使 Engine 请求更高，也不会超过这个值和代码里的 90%；App 上限是最终边界"
        },
        {
          "key": "show_status",
          "type": "bool",
          "label": "在 DGHub 显示运行状态",
          "default": true
        }
      ]
    }
  ]
}