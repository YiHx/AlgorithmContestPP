{
  "id": "ojhc_link",
  "name": "OJHC 硬核模式",
  "version": "0.1.0",
  "sdk": "1",
  "author": "xuanh08",
  "description": "OJ Hardcore Engine 的设备执行端：只接受 Engine 的租约化输出指令，租约过期/断开立即归零。",
  "entry": "main.py",
  "capabilities": {
    "startup_check": true
  },
  "config_schema": [
    {
      "section": "模式",
      "fields": [
        {
          "key": "mode",
          "type": "select",
          "label": "电击模式",
          "default": "simple",
          "options": [
            {
              "label": "简单：只有长时间没有 AC 才电（默认）",
              "value": "simple"
            },
            {
              "label": "压力算法：按排名/进度/卡题程度触发",
              "value": "pressure"
            }
          ],
          "description": "简单模式只看「距上次 AC 多久」；压力算法模式看完整压力分与等级"
        },
        {
          "key": "no_ac_minutes",
          "type": "number",
          "label": "简单模式：多久没 AC 电一次（分钟）",
          "default": 20,
          "min": 5,
          "max": 120
        },
        {
          "key": "no_ac_escalation",
          "type": "percent",
          "label": "每次「没 AC」电击比上次加强多少",
          "default": 5,
          "min": 0,
          "max": 20,
          "description": "逐次递增，封顶 90%（App 上限的 90%）"
        }
      ]
    },
    {
      "section": "连接",
      "fields": [
        {
          "key": "link_file",
          "type": "text",
          "label": "Engine 链路文件（留空自动找 ~/.ojhc/device_link.json）",
          "default": ""
        }
      ]
    },
    {
      "section": "强度（App 上限的百分比）",
      "fields": [
        {
          "key": "base_intensity",
          "type": "percent",
          "label": "基础强度（s=2 档）",
          "default": 74,
          "min": 40,
          "max": 90,
          "description": "输出去电强度 = 基础强度 + (档位-2)×每档递增，均为 App 上限的百分比"
        },
        {
          "key": "intensity_step",
          "type": "percent",
          "label": "每档递增",
          "default": 4,
          "min": 0,
          "max": 10
        },
        {
          "key": "max_s",
          "type": "number",
          "label": "最高档位 s（2-5）",
          "default": 4,
          "min": 2,
          "max": 5
        },
        {
          "key": "preset",
          "type": "preset",
          "label": "波形预设",
          "default": "呼吸"
        }
      ]
    },
    {
      "section": "频率与安全",
      "fields": [
        {
          "key": "cooldown_s",
          "type": "number",
          "label": "两次电击最小间隔（秒）",
          "default": 90,
          "min": 10,
          "max": 300
        },
        {
          "key": "hourly_cap",
          "type": "number",
          "label": "每小时最多次数",
          "default": 30,
          "min": 5,
          "max": 60
        },
        {
          "key": "allow_level_up",
          "type": "bool",
          "label": "等级上升时也电一下",
          "default": false
        },
        {
          "key": "max_intensity_pct",
          "type": "percent",
          "label": "本插件硬上限（0~100%，100%=App 上限）",
          "default": 90,
          "min": 0,
          "max": 100,
          "description": "没 AC 的递增电击也停在这个值；代码兜底 100%，永远不会超过 App 上限"
        },
        {
          "key": "show_status",
          "type": "bool",
          "label": "在 DGHub 显示运行状态",
          "default": true
        }
      ]
    }
  ]
}